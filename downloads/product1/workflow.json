    },
    {
      "parameters": {
        "chatId": "={{ $('Extract Blog Text').item.json.chatId }}",
        "text": "=🎬 5 YOUTUBE SHORTS IDEAS\n\n{{ $json.message.content }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
